        "position": {
          "x": 50,
          "y": 340
        },
        "parameterValues": {},
        "label": "Hat Encoder"
      },
      {
        "id": "kick_voice",
        "definitionId": "analog_bass_drum",
        "position": {
          "x": 320,
          "y": 100
        },
        "parameterValues": {
          "freq": 55.0,
          "tone": 0.4,
          "decay": 0.2
        },
        "label": "Kick"
      },
      {
        "id": "snare_voice",
        "definitionId": "analog_snare_drum",
        "position": {
          "x": 320,
          "y": 220
        },
        "parameterValues": {
          "freq": 180.0,
          "tone": 0.5,
          "decay": 0.1,
          "snappy": 0.6
        },
        "label": "Snare"
      },
      {
        "id": "hat_voice",
        "definitionId": "hihat",
        "position": {
          "x": 320,
          "y": 340
        },
        "parameterValues": {
          "freq": 3000.0,
          "tone": 0.5,
          "decay": 0.1,
          "noisiness": 0.7
        },
        "label": "HiHat"
      },
      {
        "id": "mix",
        "definitionId": "mixer",
        "position": {
          "x": 580,
          "y": 220
        },
        "parameterValues": {
          "inputCount": "3",
          "level_1": 0.8,
          "level_2": 0.7,
          "level_3": 0.6
        },
        "label": "Mixer"
      },
      {
        "id": "audio_out",
        "definitionId": "audio_output",
        "position": {
          "x": 820,
          "y": 220
        },
        "parameterValues": {},
        "label": "Audio Out"
      }
