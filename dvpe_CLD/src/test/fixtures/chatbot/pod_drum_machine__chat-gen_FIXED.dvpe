{
  "version": "1.0.0",
  "patch": {
    "metadata": {
      "name": "Pod Drum Machine",
      "author": "DVPE AI Assistant",
      "description": "Kick, snare, and hihat for Pod",
      "created": "2026-05-17T10:40:02Z",
      "modified": "2026-05-17T10:40:02Z",
      "version": "1.0.0",
      "targetHardware": "pod",
      "sampleRate": 48000,
      "blockSize": 4
    },
    "blocks": [
      {
        "id": "kick_trig",
        "definitionId": "key",
        "position": {
          "x": 50,
          "y": 100
        },
        "parameterValues": {
          "channel": "0"
        },
        "label": "Kick Button"
      },
      {
        "id": "snare_trig",
        "definitionId": "key",
        "position": {
          "x": 50,
          "y": 220
        },
        "parameterValues": {
          "channel": "1"
        },
        "label": "Snare Button"
      },
      {
        "id": "hat_trig",
