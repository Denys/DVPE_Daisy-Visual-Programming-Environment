{
  "version": "1.0.0",
  "patch": {
    "metadata": {
      "name": "Field Mapping Subtractive",
      "author": "Codex",
      "description": "Daisy Field example patch for the Field Mapping panel. K1-K8 control a simple subtractive voice across normal, SW1, SW2, and SW1+SW2 held layers. A1 gates the amp ADSR; SW1 short press triggers a filter-drive accent; B2 cycles three damping values with key LED feedback.",
      "created": "2026-05-15T00:00:00.000Z",
      "modified": "2026-05-15T00:00:00.000Z",
      "version": "1.0.0",
      "targetHardware": "field",
      "sampleRate": 48000,
      "blockSize": 48
    },
    "blocks": [
      {
        "id": "osc1",
        "definitionId": "oscillator",
        "position": { "x": -900, "y": -120 },
        "parameterValues": {
          "freq": 110,
          "amp": 0.7,
          "waveform": "WAVE_POLYBLEP_SAW",
          "pw": 0.5
        },
        "label": "SOURCE"
      },
      {
        "id": "filter1",
        "definitionId": "svf",
        "position": { "x": -600, "y": -120 },
        "parameterValues": {
          "freq": 1200,
          "res": 0.35,
          "drive": 0.15
        },
        "label": "FILTER"
      },
      {
        "id": "amp_env",
        "definitionId": "adsr",
        "position": { "x": -600, "y": 170 },
        "parameterValues": {
          "attack": 0.01,
          "decay": 0.18,
          "sustain": 0.72,
          "release": 0.35
        },
        "label": "AMP ENV"
      },
      {
        "id": "accent_env",
        "definitionId": "ad_env",
        "position": { "x": -600, "y": 430 },
        "parameterValues": {
          "attack": 0.003,
          "decay": 0.18,
          "curve": -4
        },
        "label": "B1 ACCENT"
      },
      {
        "id": "amp_vca",
        "definitionId": "vca",
        "position": { "x": -300, "y": -120 },
        "parameterValues": {
          "gain": 0.9
        },
        "label": "AMP VCA"
      },
      {
        "id": "reverb1",
        "definitionId": "reverb_sc",
        "position": { "x": 0, "y": -120 },
        "parameterValues": {
          "feedback": 0.55,
          "lpfreq": 9000,
          "wet_dry": 0.2
        },
        "label": "SPACE"
      },
      {
        "id": "out1",
        "definitionId": "audio_output",
        "position": { "x": 330, "y": -120 },
        "parameterValues": {},
        "label": "OUT"
      }
    ],
    "connections": [
      {
        "id": "c_osc_filter",
        "sourceBlockId": "osc1",
        "sourcePortId": "out",
        "targetBlockId": "filter1",
        "targetPortId": "in",
        "type": "audio"
      },
      {
        "id": "c_filter_vca",
        "sourceBlockId": "filter1",
        "sourcePortId": "low",
        "targetBlockId": "amp_vca",
        "targetPortId": "in",
        "type": "audio"
      },
      {
        "id": "c_amp_env_vca",
        "sourceBlockId": "amp_env",
        "sourcePortId": "out",
        "targetBlockId": "amp_vca",
        "targetPortId": "gain_cv",
        "type": "cv"
      },
      {
        "id": "c_accent_drive",
        "sourceBlockId": "accent_env",
        "sourcePortId": "out",
        "targetBlockId": "filter1",
        "targetPortId": "drive_cv",
        "type": "cv"
      },
      {
        "id": "c_vca_reverb_l",
        "sourceBlockId": "amp_vca",
        "sourcePortId": "out",
        "targetBlockId": "reverb1",
        "targetPortId": "in_l",
        "type": "audio"
      },
      {
        "id": "c_vca_reverb_r",
        "sourceBlockId": "amp_vca",
        "sourcePortId": "out",
        "targetBlockId": "reverb1",
        "targetPortId": "in_r",
        "type": "audio"
      },
      {
        "id": "c_reverb_out_l",
        "sourceBlockId": "reverb1",
        "sourcePortId": "out_l",
        "targetBlockId": "out1",
        "targetPortId": "left",
        "type": "audio"
      },
      {
        "id": "c_reverb_out_r",
        "sourceBlockId": "reverb1",
        "sourcePortId": "out_r",
        "targetBlockId": "out1",
        "targetPortId": "right",
        "type": "audio"
      }
    ],
    "hardwareConfig": {
      "platform": "field",
      "pinMapping": {},
      "fieldControlMappings": [
        {
          "controlType": "knob",
          "controlId": "K1",
          "layer": "normal",
          "targetBlockId": "filter1",
          "targetParameterId": "freq",
          "mappingType": "log",
          "outputRange": [80, 9000]
        },
        {
          "controlType": "knob",
          "controlId": "K2",
          "layer": "normal",
          "targetBlockId": "filter1",
          "targetParameterId": "res",
          "mappingType": "scaled",
          "outputRange": [0, 0.9]
        },
        {
          "controlType": "knob",
          "controlId": "K3",
          "layer": "normal",
          "targetBlockId": "amp_env",
          "targetParameterId": "attack",
          "mappingType": "log",
          "outputRange": [0.001, 0.4]
        },
        {
          "controlType": "knob",
          "controlId": "K4",
          "layer": "normal",
          "targetBlockId": "amp_env",
          "targetParameterId": "decay",
          "mappingType": "log",
          "outputRange": [0.02, 1.2]
        },
        {
          "controlType": "knob",
          "controlId": "K5",
          "layer": "normal",
          "targetBlockId": "amp_env",
          "targetParameterId": "sustain",
          "mappingType": "scaled",
          "outputRange": [0.15, 1]
        },
        {
          "controlType": "knob",
          "controlId": "K6",
          "layer": "normal",
          "targetBlockId": "amp_env",
          "targetParameterId": "release",
          "mappingType": "log",
          "outputRange": [0.03, 2.5]
        },
        {
          "controlType": "knob",
          "controlId": "K7",
          "layer": "normal",
          "targetBlockId": "reverb1",
          "targetParameterId": "feedback",
          "mappingType": "scaled",
          "outputRange": [0.05, 0.9]
        },
        {
          "controlType": "knob",
          "controlId": "K8",
          "layer": "normal",
          "targetBlockId": "reverb1",
          "targetParameterId": "wet_dry",
          "mappingType": "scaled",
          "outputRange": [0, 0.55]
        },
        {
          "controlType": "knob",
          "controlId": "K1",
          "layer": "sw1",
          "targetBlockId": "reverb1",
          "targetParameterId": "lpfreq",
          "mappingType": "log",
          "outputRange": [1000, 18000]
        },
        {
          "controlType": "knob",
          "controlId": "K2",
          "layer": "sw1",
          "targetBlockId": "reverb1",
          "targetParameterId": "feedback",
          "mappingType": "scaled",
          "outputRange": [0.05, 0.95]
        },
        {
          "controlType": "knob",
          "controlId": "K3",
          "layer": "sw1",
          "targetBlockId": "filter1",
          "targetParameterId": "freq",
          "mappingType": "log",
          "outputRange": [120, 14000]
        },
        {
          "controlType": "knob",
          "controlId": "K4",
          "layer": "sw1",
          "targetBlockId": "filter1",
          "targetParameterId": "res",
          "mappingType": "scaled",
          "outputRange": [0, 0.98]
        },
        {
          "controlType": "knob",
          "controlId": "K1",
          "layer": "sw2",
          "targetBlockId": "amp_env",
          "targetParameterId": "attack",
          "mappingType": "log",
          "outputRange": [0.001, 1]
        },
        {
          "controlType": "knob",
          "controlId": "K2",
          "layer": "sw2",
          "targetBlockId": "amp_env",
          "targetParameterId": "release",
          "mappingType": "log",
          "outputRange": [0.02, 4]
        },
        {
          "controlType": "knob",
          "controlId": "K1",
          "layer": "sw1_sw2",
          "targetBlockId": "reverb1",
          "targetParameterId": "wet_dry",
          "mappingType": "scaled",
          "outputRange": [0, 0.8]
        },
        {
          "controlType": "key",
          "controlId": "A1",
          "layer": "normal",
          "targetBlockId": "amp_env",
          "targetPortId": "gate",
          "keyOutput": "gate"
        },
        {
          "controlType": "switch",
          "controlId": "SW1",
          "layer": "normal",
          "interaction": "shortPress",
          "targetBlockId": "accent_env",
          "targetPortId": "trig",
          "keyOutput": "trigger"
        },
        {
          "controlType": "key",
          "controlId": "B2",
          "layer": "normal",
          "targetBlockId": "reverb1",
          "targetParameterId": "lpfreq",
          "keyOutput": "toggle3",
          "toggleStates": [
            { "label": "Dark", "value": 2000, "led": "off" },
            { "label": "Open", "value": 9000, "led": "blink" },
            { "label": "Bright", "value": 16000, "led": "on" }
          ]
        }
      ],
      "peripherals": {
        "useExternalCodec": false,
        "useSdram": true,
        "audioBlockSize": 48,
        "sampleRate": 48000
      }
    }
  }
}
